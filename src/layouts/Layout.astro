---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  movie?: any;
}

const {
  title = "BollyHub - Watch Bollywood, Hollywood & South Hindi Dubbed Movies Free",
  description = "Watch Bollywood, Hollywood, South Hindi Dubbed movies in Full HD online for free. Direct 1-click fast downloads, zero buffering on BollyHub.",
  image = "https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?w=1200&auto=format&fit=crop&q=80",
  canonicalUrl = "https://bollyhub.devendradubey61.workers.dev",
  movie = null
} = Astro.props;

// Schema.org structured data for instantaneous Google Crawling & Rich Snippets
const schemaData = movie ? {
  "@context": "https://schema.org",
  "@type": "Movie",
  "name": movie.title,
  "image": movie.poster_url || image,
  "datePublished": movie.release_year,
  "genre": movie.imdb?.genres ? movie.imdb.genres.split(',').map((g: string) => g.trim()) : (movie.categories || ["Action"]),
  "description": movie.imdb?.summary || description,
  "director": {
    "@type": "Person",
    "name": movie.imdb?.director || "N/A"
  },
  "actor": (movie.imdb?.cast || []).map((actorName: string) => ({
    "@type": "Person",
    "name": actorName
  })),
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": movie.imdb?.rating || "8.0",
    "bestRating": "10",
    "ratingCount": "2500"
  }
} : {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "BollyHub",
  "url": "https://bollyhub.devendradubey61.workers.dev/",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://bollyhub.devendradubey61.workers.dev/?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

  <!-- OpenGraph Metadata -->
  <meta property="og:locale" content="en_US" />
  <meta property="og:type" content={movie ? "video.movie" : "website"} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image} />
  <meta property="og:site_name" content="BollyHub" />

  <!-- Twitter Card Metadata -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />

  <!-- Google SEO Structured Data (JSON-LD) -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <script is:inline>
    /* apply saved theme before paint (default: dark for cinema OTT experience) */
    (function(){ try{ var t = localStorage.getItem('kd-theme') || 'dark'; document.documentElement.setAttribute('data-theme', t); }catch(e){} })();
