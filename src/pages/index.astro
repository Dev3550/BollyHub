---
import Layout from '../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';

// Read verified movies database at build time (SSG - Pre-rendered Static HTML)
const moviesDataPath = path.resolve('./data/movies.json');
let movies: any[] = [];
try {
  const raw = fs.readFileSync(moviesDataPath, 'utf-8');
  movies = JSON.parse(raw);
} catch (e) {
  movies = [];
}

function cleanText(text: string) {
  if (!text) return '';
  return text.replace(/BollyFlix/gi, 'BollyHub').replace(/bollyflix/gi, 'bollyhub').trim();
}

function getFastPosterUrl(posterUrl: string) {
  if (posterUrl && posterUrl.startsWith('http') && !posterUrl.includes('vlcsnap') && !posterUrl.includes('screenshot')) {
    return posterUrl;
  }
  return 'https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?w=500&auto=format&fit=crop&q=60';
}

// Prepare Top 10 movies (sorted by rating / popularity)
const top10Movies = [...movies]
  .sort((a, b) => {
    const rateA = parseFloat(a.imdb?.rating || '7.0');
    const rateB = parseFloat(b.imdb?.rating || '7.0');
    return rateB - rateA;
  })
  .slice(0, 10);

// Prepare Latest Releases for horizontal quick strip
const latestReleases = [...movies].slice(0, 16);
---

<Layout
  title="BollyHub - Watch Bollywood, Hollywood & South Hindi Dubbed Movies Free Online"
  description="Watch Bollywood, Hollywood, South Hindi Dubbed movies in Full HD online for free. Direct 1-click fast downloads, zero ads, zero buffering on BollyHub."
>
  <!-- ================= HERO INTRO ================= -->
  <div class="hero-box">
    <h1>Watch <span>HD Movies & Series</span> Free Online</h1>
    <p>Stream high-definition Bollywood, Hollywood & South Hindi Dubbed movies online with fast 1-click direct downloads on BollyHub.</p>
  </div>

  <!-- ================= OFFICIAL TELEGRAM COMMUNITY BANNER ================= -->
  <section class="tg-banner-section">
    <div class="wrap">
      <div class="tg-banner-card">
        <div class="tg-banner-left">
          <div class="tg-badge">
            <span class="tg-dot"></span>
            <span>VERIFIED OFFICIAL CHANNEL</span>
          </div>
          <h3>Join <b>BollyHub Official™</b> on Telegram</h3>
          <p>Get instant notifications for new 1080p/720p blockbuster releases, 1-click high-speed mirrors, and request any movie directly from our admin team!</p>
        </div>
        <a
          href="https://t.me/+mu3upENk3GFmZTFl"
          target="_blank"
          rel="noopener noreferrer"
          class="tg-join-btn"
          aria-label="Join Official BollyHub Telegram Channel"
        >
          <svg viewBox="0 0 24 24">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
          </svg>
          <span>Join Channel Now</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ================= TOP 10 THIS WEEK CAROUSEL ================= -->
  <section class="t10">
    <div class="wrap">
      <div class="t10-head">
        <div class="bar-v"></div>
        <h2>Top 10 <em>This Week</em></h2>
        <div class="line"></div>
        <div class="t10-arrows">
          <button id="t10prev" aria-label="Previous" disabled>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <button id="t10next" aria-label="Next">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
      </div>
      <div class="t10-row" id="t10row">
        {top10Movies.map((m, idx) => {
          const cleanTitle = cleanText(m.title);
          const poster = getFastPosterUrl(m.poster_url);
          const categoryTag = m.categories && m.categories[0] ? m.categories[0] : 'HD';
          const rating = m.imdb?.rating || '8.0';
          const slug = m.slug || m.id;
          const isTwoDigit = (idx + 1) >= 10;

          return (
            <a href={`/movie/${slug}/`} class={`t10-item ${isTwoDigit ? 'two' : ''}`}>
              <div class="t10-wrap">
                <div class="t10-num">{idx + 1}</div>
                <div class="t10-poster">
                  <img src={poster} alt={cleanTitle} loading="lazy" decoding="async" />
                  <span class="t10-type">{categoryTag}</span>
                  <span class="t10-rate">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                    {rating}
                  </span>
                </div>
              </div>
              <h3>{cleanTitle}</h3>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ================= LATEST RELEASES STRIP ================= -->
  <section class="block">
    <div class="wrap">
      <div class="sec-head">
        <h2>Latest Releases</h2>
      </div>
      <div class="strip" id="latestEpStrip">
        {latestReleases.map((m) => {
          const cleanTitle = cleanText(m.title);
          const poster = getFastPosterUrl(m.poster_url);
          const categoryTag = m.categories && m.categories[0] ? m.categories[0] : 'HD';
          const slug = m.slug || m.id;

          return (
            <a href={`/movie/${slug}/`} class="ep">
              <div class="ep-img">
                <img src={poster} alt={cleanTitle} loading="lazy" decoding="async" />
                <span class="ep-badge">{categoryTag}</span>
              </div>
              <h3 style="font-size:12.5px;font-weight:600;margin-top:6px;line-height:1.3;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                {cleanTitle}
              </h3>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ================= MAIN MOVIES GRID ================= -->
  <section class="block">
    <div class="wrap">
      <div class="sec-head">
        <div style="display:flex;align-items:center;gap:10px;">
          <h2 id="gridTitle">All Movies</h2>
          <span style="font-size: 13px; font-weight: 500; color: var(--muted);">
            (<strong id="total-count-display" style="color: var(--accent);">{movies.length}</strong> titles)
          </span>
        </div>
        <select class="sort" id="sortSelect" aria-label="Sort movies">
          <option value="latest">Latest Added</option>
          <option value="rated">Best Rated</option>
          <option value="year">Newest Year</option>
          <option value="title">Title (A-Z)</option>
        </select>
      </div>

      <!-- Main Movies Grid (Pre-rendered Static HTML for Google SEO Indexing) -->
      <div class="grid" id="dramaGrid">
        {movies.map((m, idx) => {
          const cleanTitle = cleanText(m.title);
          const poster = getFastPosterUrl(m.poster_url);
          const categoryTag = m.categories && m.categories[0] ? m.categories[0] : 'HD';
          const rating = m.imdb?.rating || '8.0';
          const year = m.release_year || '2024';
          const slug = m.slug || m.id;
          const genres = Array.isArray(m.categories) ? m.categories.slice(0, 2).join(' • ') : '';

          return (
            <div
              class="movie-card-wrapper"
              data-original-index={idx}
              data-categories={JSON.stringify(m.categories || [])}
              data-title={cleanTitle.toLowerCase()}
              data-year={year}
              data-rating={rating}
            >
              <a href={`/movie/${slug}/`} class="card">
                <div class="poster">
                  <img src={poster} alt={cleanTitle} loading="lazy" decoding="async" />
                  <span class="pill">{categoryTag}</span>
                  <span class="rate">★ {rating}</span>
                  <div class="info-b">
                    <span>{categoryTag}</span>
                    <i>•</i>
                    <span>{year}</span>
                  </div>
                </div>
                <h3>{cleanTitle}</h3>
                <small>{genres || `${categoryTag} • ${year}`}</small>
              </a>
            </div>
          );
        })}
      </div>

      <!-- Responsive Numeric Pagination Bar -->
      <div class="pager" id="pagination"></div>
    </div>
  </section>

  <!-- ================= CLIENT-SIDE SCRIPTS ================= -->
  <script is:inline>
    (function() {
      // 1. TOP 10 HORIZONTAL CAROUSEL CONTROLS
      const t10row = document.getElementById('t10row');
      const t10prev = document.getElementById('t10prev');
      const t10next = document.getElementById('t10next');

      if (t10row && t10prev && t10next) {
        function updateT10Arrows() {
          const atStart = t10row.scrollLeft <= 10;
          const atEnd = t10row.scrollLeft + t10row.clientWidth >= t10row.scrollWidth - 10;
          t10prev.disabled = atStart;
          t10next.disabled = atEnd;
        }

        t10prev.addEventListener('click', () => {
          t10row.scrollBy({ left: -360, behavior: 'smooth' });
        });

        t10next.addEventListener('click', () => {
          t10row.scrollBy({ left: 360, behavior: 'smooth' });
        });

        t10row.addEventListener('scroll', updateT10Arrows, { passive: true });
        updateT10Arrows();
      }

      // 2. MAIN CATALOG FILTERING, SORTING & PAGINATION
      const grid = document.getElementById('dramaGrid');
      let cards = Array.from(document.querySelectorAll('.movie-card-wrapper'));
      const sortSelect = document.getElementById('sortSelect');
      const gridTitle = document.getElementById('gridTitle');
      const totalDisplay = document.getElementById('total-count-display');
      const paginationContainer = document.getElementById('pagination');
      const navLinks = document.querySelectorAll('.nav a[data-cat]');
      const searchInput = document.getElementById('searchInput');
      const acBox = document.getElementById('acBox');

      let currentCategory = 'all';
      let currentQuery = '';
      let currentSort = 'latest';
      let currentPage = 1;

      function getPageSize() {
        return window.innerWidth <= 768 ? 12 : 24;
      }

      function sortCards(cardList) {
        return cardList.sort((a, b) => {
          if (currentSort === 'rated') {
            const rA = parseFloat(a.getAttribute('data-rating') || '0');
            const rB = parseFloat(b.getAttribute('data-rating') || '0');
            return rB - rA;
          } else if (currentSort === 'year') {
            const yA = parseInt(a.getAttribute('data-year') || '0', 10);
            const yB = parseInt(b.getAttribute('data-year') || '0', 10);
            return yB - yA;
          } else if (currentSort === 'title') {
            const tA = a.getAttribute('data-title') || '';
            const tB = b.getAttribute('data-title') || '';
            return tA.localeCompare(tB);
          } else {
            // default 'latest'
            const iA = parseInt(a.getAttribute('data-original-index') || '0', 10);
            const iB = parseInt(b.getAttribute('data-original-index') || '0', 10);
            return iA - iB;
          }
        });
      }

      function applyFilters() {
        let matching = cards.filter(card => {
          const title = card.getAttribute('data-title') || '';
          const year = card.getAttribute('data-year') || '';
          let cats = [];
          try {
            cats = JSON.parse(card.getAttribute('data-categories') || '[]');
          } catch(e) {}

          const catUpper = currentCategory.toUpperCase();
          const matchesCat = currentCategory === 'all' || 
            (currentCategory === 'trending' ? true : cats.some(c => c.toUpperCase().includes(catUpper)));

          const matchesQuery = !currentQuery || 
            title.includes(currentQuery) || 
            year.includes(currentQuery) || 
            cats.some(c => c.toLowerCase().includes(currentQuery));

          return matchesCat && matchesQuery;
        });

        // Reorder DOM based on sort
        matching = sortCards(matching);

        if (totalDisplay) totalDisplay.textContent = matching.length;

        const pageSize = getPageSize();
        const totalPages = Math.ceil(matching.length / pageSize) || 1;
        currentPage = Math.min(Math.max(1, currentPage), totalPages);

        cards.forEach(c => c.style.display = 'none');

        const startIdx = (currentPage - 1) * pageSize;
        const pageItems = matching.slice(startIdx, startIdx + pageSize);
        pageItems.forEach(c => {
          c.style.display = '';
          grid.appendChild(c); // maintains current sorted order
        });

        renderPagination(totalPages);
      }

      function renderPagination(totalPages) {
        if (!paginationContainer) return;
        if (totalPages <= 1) {
          paginationContainer.innerHTML = '';
          return;
        }

        let html = '';
        if (currentPage > 1) {
          html += `<a data-page="${currentPage - 1}">« Prev</a>`;
        } else {
          html += `<span style="opacity:0.4;cursor:default;">« Prev</span>`;
        }

        const maxButtons = 5;
        let startPage = Math.max(1, currentPage - Math.floor(maxButtons / 2));
        let endPage = startPage + maxButtons - 1;
        if (endPage > totalPages) {
          endPage = totalPages;
          startPage = Math.max(1, endPage - maxButtons + 1);
        }

        if (startPage > 1) {
          html += `<a data-page="1">1</a>`;
          if (startPage > 2) html += `<span>...</span>`;
        }

        for (let i = startPage; i <= endPage; i++) {
          if (i === currentPage) {
            html += `<span class="cur">${i}</span>`;
          } else {
            html += `<a data-page="${i}">${i}</a>`;
          }
        }

        if (endPage < totalPages) {
          if (endPage < totalPages - 1) html += `<span>...</span>`;
          html += `<a data-page="${totalPages}">${totalPages}</a>`;
        }

        if (currentPage < totalPages) {
          html += `<a data-page="${currentPage + 1}">Next »</a>`;
        } else {
          html += `<span style="opacity:0.4;cursor:default;">Next »</span>`;
        }

        paginationContainer.innerHTML = html;
        paginationContainer.querySelectorAll('a[data-page]').forEach(b => {
          b.addEventListener('click', () => {
            currentPage = parseInt(b.getAttribute('data-page'), 10);
            applyFilters();
            grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
          });
        });
      }

      // Sort select handler
      if (sortSelect) {
        sortSelect.addEventListener('change', (e) => {
          currentSort = e.target.value;
          currentPage = 1;
          applyFilters();
        });
      }

      // Nav Category clicks
      navLinks.forEach(link => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          navLinks.forEach(l => l.classList.remove('on'));
          link.classList.add('on');

          currentCategory = (link.getAttribute('data-cat') || 'all').toLowerCase();
          currentPage = 1;

          if (gridTitle) {
            gridTitle.textContent = link.textContent.trim();
          }

          applyFilters();
        });
      });

      // 3. SEARCH & REAL-TIME AUTOCOMPLETE DROPDOWN (#acBox)
      if (searchInput && acBox) {
        function updateAutocomplete() {
          const q = searchInput.value.trim().toLowerCase();
          if (!q || q.length < 2) {
            acBox.classList.remove('on');
            acBox.innerHTML = '';
            return;
          }

          const matched = cards.filter(c => {
            const t = c.getAttribute('data-title') || '';
            const y = c.getAttribute('data-year') || '';
            return t.includes(q) || y.includes(q);
          }).slice(0, 6);

          if (matched.length === 0) {
            acBox.innerHTML = '<div style="padding:14px;color:var(--muted);font-size:13px;text-align:center;">No matching titles found</div>';
            acBox.classList.add('on');
            return;
          }

          acBox.innerHTML = matched.map(c => {
            const a = c.querySelector('a');
            const href = a ? a.getAttribute('href') : '#';
            const img = c.querySelector('img');
            const imgSrc = img ? img.getAttribute('src') : '';
            const title = c.querySelector('h3') ? c.querySelector('h3').textContent : '';
            const rating = c.getAttribute('data-rating') || '8.0';
            const year = c.getAttribute('data-year') || '';

            return `
              <a class="it" href="${href}">
                <img src="${imgSrc}" alt="${title}" style="width:40px;height:55px;object-fit:cover;border-radius:6px;background:var(--card);" />
                <div>
                  <div style="font-size:13.5px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${title}</div>
                  <div style="font-size:12px;color:var(--muted);margin-top:2px;">★ ${rating} • ${year}</div>
                </div>
              </a>
            `;
          }).join('');

          acBox.classList.add('on');
        }

        searchInput.addEventListener('input', (e) => {
          currentQuery = e.target.value.toLowerCase().trim();
          currentPage = 1;
          applyFilters();
          updateAutocomplete();
        });

        searchInput.addEventListener('focus', updateAutocomplete);

        document.addEventListener('click', (e) => {
          if (!searchInput.contains(e.target) && !acBox.contains(e.target)) {
            acBox.classList.remove('on');
          }
        });
      }

      // Check URL query parameters (e.g. /?q=leo or /?cat=bollywood)
      const urlParams = new URLSearchParams(window.location.search);
      const qParam = urlParams.get('q');
      const catParam = urlParams.get('cat');
      if (qParam && searchInput) {
        searchInput.value = qParam;
        currentQuery = qParam.toLowerCase().trim();
      }
      if (catParam) {
        const matchingLink = Array.from(navLinks).find(l => l.getAttribute('data-cat')?.toLowerCase() === catParam.toLowerCase());
        if (matchingLink) {
          navLinks.forEach(l => l.classList.remove('on'));
          matchingLink.classList.add('on');
          currentCategory = catParam.toLowerCase();
          if (gridTitle) gridTitle.textContent = matchingLink.textContent.trim();
        }
      }

      window.addEventListener('resize', () => applyFilters());

      // Initial filter render
      applyFilters();

      // 4. BACKGROUND REAL-TIME SYNC FOR NEWLY UPLOADED MOVIES
      fetch('/data/movies.json?v=' + Date.now())
        .then(r => r.json())
        .then(latestMovies => {
          if (!Array.isArray(latestMovies)) return;
          const existingSlugs = new Set(cards.map(c => {
            const a = c.querySelector('a');
            return a ? a.getAttribute('href') : '';
          }));

          let addedAny = false;
          for (const m of latestMovies) {
            const slug = m.slug || m.id;
            const href = `/movie/${slug}/`;
            if (!existingSlugs.has(href)) {
              const wrapper = document.createElement('div');
              wrapper.className = 'movie-card-wrapper';
              wrapper.setAttribute('data-original-index', cards.length);
              wrapper.setAttribute('data-categories', JSON.stringify(m.categories || []));
              wrapper.setAttribute('data-title', (m.title || '').toLowerCase());
              wrapper.setAttribute('data-year', m.release_year || '2024');
              wrapper.setAttribute('data-rating', m.imdb?.rating || '8.0');

              const poster = (m.poster_url && m.poster_url.startsWith('http') && !m.poster_url.includes('vlcsnap'))
                ? m.poster_url
                : 'https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?w=500&auto=format&fit=crop&q=60';
              const catTag = (m.categories && m.categories[0]) ? m.categories[0] : 'HD';
              const rating = m.imdb?.rating || '8.0';
              const cleanTitle = (m.title || '').replace(/BollyFlix/gi, 'BollyHub');
              const genres = Array.isArray(m.categories) ? m.categories.slice(0, 2).join(' • ') : '';

              wrapper.innerHTML = `
                <a href="${href}" class="card">
                  <div class="poster">
                    <img src="${poster}" alt="${cleanTitle}" loading="lazy" decoding="async" />
                    <span class="pill">${catTag}</span>
                    <span class="rate">★ ${rating}</span>
                    <div class="info-b">
                      <span>${catTag}</span>
                      <i>•</i>
                      <span>${m.release_year || '2024'}</span>
                    </div>
                  </div>
                  <h3>${cleanTitle}</h3>
                  <small>${genres || `${catTag} • ${m.release_year || '2024'}`}</small>
                </a>
              `;

              cards.unshift(wrapper);
              addedAny = true;
            }
          }

          if (addedAny) {
            applyFilters();
          }
        })
        .catch(() => {});
    })();
  </script>
</Layout>
